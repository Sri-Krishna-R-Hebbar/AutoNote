# Copy this file to .env and fill in your key(s).
#
# Groq is used for note-writing only. Transcription runs locally (faster-whisper,
# open-source, from Hugging Face) - no key needed for that part.
GROQ_API_KEY=

# Optional overrides
# GROQ_LLM_MODEL=openai/gpt-oss-20b
#
# Groq's free tier caps out around 7000-8000 total tokens PER MINUTE per
# model, org-wide - a request that alone exceeds that is rejected outright
# (HTTP 413), not something retrying later fixes. These two keep every
# request comfortably under that; only raise them if you're on a paid Groq
# tier with a higher limit.
# NOTES_SINGLE_PASS_CHAR_LIMIT=9000
# GROQ_MAX_TOKENS=3000

# Local transcription model size: tiny | base (default) | small | medium | large-v3
# Bigger = more accurate but slower/heavier - "base" already pushes close to the limit on
# Render's free 512MB tier for longer videos. If you see jobs getting silently lost
# ("This job was lost...") during transcription, that's an out-of-memory kill - drop to
# "tiny" here first before anything else.
# WHISPER_MODEL_SIZE=base
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS=2

# Optional - enables "path 2": reading on-screen text/handwriting/diagrams out
# of video frames (slides, whiteboards, code, annotations) using a
# vision-language model via OpenRouter (https://openrouter.ai/keys - has a
# free tier). Without this, notes are generated from the audio transcript
# alone, same as before. OpenRouter's free model slugs rotate often - if
# on-screen content stops working, check what's currently live with:
#   curl -s https://openrouter.ai/api/v1/models | \
#     python -c "import json,sys; [print(m['id']) for m in json.load(sys.stdin)['data'] \
#     if ':free' in m['id'] and 'image' in m.get('architecture', {}).get('input_modalities', [])]"
# OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=qwen/qwen3.8-27b:free

# Optional - tune how the video is sampled for path 2 above.
# FRAME_SAMPLE_INTERVAL_SECONDS=5
# FRAME_DIFF_THRESHOLD=12
# FRAME_MAX_CALLS=30
# FRAME_MAX_WIDTH=960

# Optional - restrict CORS to your deployed frontend origin in production
# (defaults to "*" if unset, which is fine since the frontend is served by
# this same Flask app).
# FRONTEND_ORIGIN=https://your-app.onrender.com
