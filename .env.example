# Copy this file to .env and fill in your key(s).
#
# Groq is used for note-writing only. Transcription runs locally (faster-whisper,
# open-source, from Hugging Face) - no key needed for that part.
GROQ_API_KEY=

# Optional overrides
# GROQ_LLM_MODEL=openai/gpt-oss-20b

# Local transcription model size: tiny | base (default) | small | medium | large-v3
# Bigger = more accurate but slower/heavier. "base" is a good default for a free-tier CPU host.
# WHISPER_MODEL_SIZE=base
# WHISPER_COMPUTE_TYPE=int8

# Optional - enables "path 2": reading on-screen text/handwriting/diagrams out
# of video frames (slides, whiteboards, code, annotations) using a Qwen
# vision-language model via OpenRouter (https://openrouter.ai/keys - has a
# free tier). Without this, notes are generated from the audio transcript
# alone, same as before.
# OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# Optional - tune how the video is sampled for path 2 above.
# FRAME_SAMPLE_INTERVAL_SECONDS=5
# FRAME_DIFF_THRESHOLD=12
# FRAME_MAX_CALLS=30
# FRAME_MAX_WIDTH=960

# Optional - restrict CORS to your deployed frontend origin in production
# (defaults to "*" if unset, which is fine since the frontend is served by
# this same Flask app).
# FRONTEND_ORIGIN=https://your-app.onrender.com
