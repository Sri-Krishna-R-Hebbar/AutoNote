# Copy this file to .env and fill in your key.
#
# Groq is used for note-writing only. Transcription runs locally (faster-whisper,
# open-source, from Hugging Face) - no key needed for that part.
GROQ_API_KEY=

# Optional overrides
# GROQ_LLM_MODEL=openai/gpt-oss-20b

# Local transcription model size: tiny | base (default) | small | medium | large-v3
# Bigger = more accurate but slower/heavier. "base" is a good default for a free-tier CPU host.
# WHISPER_MODEL_SIZE=base
# WHISPER_COMPUTE_TYPE=int8

# Optional - restrict CORS to your deployed frontend origin in production
# (defaults to "*" if unset, which is fine since the frontend is served by
# this same Flask app).
# FRONTEND_ORIGIN=https://your-app.onrender.com

# Optional - only needed if YouTube starts showing "Sign in to confirm you're
# not a bot" errors for your hosting provider's IP (common on Render/AWS/GCP).
# Export cookies.txt from a logged-in browser session (e.g. with the
# "Get cookies.txt" browser extension) and either:
#   - point to the file directly (only works if the file is on the same
#     machine, e.g. for local testing):
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
#   - or paste the whole file's contents here (works on Render, since env
#     vars support multi-line values):
# YTDLP_COOKIES=

# Optional - a bgutil-ytdlp-pot-provider HTTP server (see render.yaml), used
# together with cookies to reliably get past YouTube's bot-check and its
# newer "SABR-only" streaming restrictions. On Render this is auto-wired via
# the second `autonote-pot` service defined in render.yaml - you shouldn't
# need to set this by hand there. For local testing against a provider
# running on your own machine (e.g. `docker run -p 127.0.0.1:4416:4416
# brainicism/bgutil-ytdlp-pot-provider`), set the full URL:
# BGUTIL_POT_BASE_URL=http://127.0.0.1:4416
